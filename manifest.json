{
  "schemaVersion": 1,
  "id": "io.github.howdyitskyle.weathering",
  "name": "Weathering",
  "version": "1.2.3",
  "author": "howdyitskyle",
  "license": "MIT",
  "description": "A weather widget for the Omarchy bar: current conditions, UV, pressure, wind direction, hourly and 7-day forecast, air quality, and sun/moon times in one panel.",
  "homepage": "https://github.com/howdyitskyle/weathering-omarchy-plugin",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Weathering",
    "description": "Weather icon in the bar; click for current conditions, hourly and 7-day forecast, air quality and sun/moon times.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "unit": "auto",
      "refreshMinutes": 15,
      "showHourly": true,
      "showAirQuality": true,
      "showMetrics": true,
      "showSun": true,
      "show7day": true,
      "showFeelsLike": true,
      "hourlyCells": 6
    },
    "schema": [
      {
        "key": "unit",
        "type": "enum",
        "label": "Units",
        "options": ["auto", "metric", "imperial"],
        "defaultValue": "auto",
        "description": "Temperature and wind units. Auto follows your locale and country."
      },
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "showHourly",
        "type": "boolean",
        "label": "Show hourly forecast",
        "defaultValue": true
      },
      {
        "key": "showAirQuality",
        "type": "boolean",
        "label": "Show air quality",
        "defaultValue": true
      },
      {
        "key": "showMetrics",
        "type": "boolean",
        "label": "Show metrics grid",
        "description": "Show the METRICS grid (wind, humidity, pressure, UV).",
        "defaultValue": true
      },
      {
        "key": "showSun",
        "type": "boolean",
        "label": "Show sun times",
        "description": "Show the sun rise/set cell in the metrics grid.",
        "defaultValue": true
      },
      {
        "key": "show7day",
        "type": "boolean",
        "label": "Show 7-day forecast",
        "defaultValue": true
      },
      {
        "key": "showFeelsLike",
        "type": "boolean",
        "label": "Show feels-like",
        "description": "Show the feels-like stat in the header.",
        "defaultValue": true
      },
      {
        "key": "hourlyCells",
        "type": "integer",
        "label": "Hourly cells",
        "min": 3,
        "max": 6,
        "step": 1,
        "defaultValue": 6,
        "description": "How many hourly forecast cells to show (3-6)."
      }
    ]
  }
}
